<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #a8e6cf, #dcedc1); min-height: 100vh; }
        .card { border-radius: 15px; border: none; box-shadow: 0 8px 25px rgba(0,0,0,0.1); }
        .btn-add { background: #00b894; color: white; }
        .btn-add:hover { background: #00a085; color: white; }
        .product-card { transition: all 0.3s ease; }
        .product-card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(0,0,0,0.15); }
    </style>
</head>
<body>

<div class="container py-5">
    <h1 class="text-center mb-4 fw-bold">Product Manager - REST API Demo</h1>

    <!-- Add/Edit Product Form -->
    <div class="card p-4 mb-4">
        <h3 id="formTitle">Add New Product</h3>
        <form id="productForm">
            <input type="hidden" id="productId">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <input type="text" id="name" class="form-control" placeholder="Product Name" required>
                </div>
                <div class="col-md-3 mb-3">
                    <input type="number" id="price" class="form-control" placeholder="Price" required>
                </div>
                <div class="col-md-3 mb-3">
                    <input type="text" id="category" class="form-control" placeholder="Category">
                </div>
                <div class="col-md-2 mb-3">
                    <button type="submit" class="btn btn-add w-100" id="submitBtn">Add</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Display Products from API -->
    <div class="row" id="productsList">
        <!-- Products will be loaded here dynamically -->
    </div>
</div>

<script>
    const API_URL = '/api/products';
    let editMode = false;

    // 1. FETCH and DISPLAY data from API on page load
    document.addEventListener('DOMContentLoaded', fetchProducts);

    async function fetchProducts() {
        const res = await fetch(API_URL);
        const result = await res.json();
        displayProducts(result.data);
    }

    // 2. DISPLAY products in DOM
    function displayProducts(products) {
        const list = document.getElementById('productsList');
        if (products.length === 0) {
            list.innerHTML = '<p class="text-center">No products found. Add one!</p>';
            return;
        }
        list.innerHTML = products.map(p => `
            <div class="col-md-4 mb-4">
                <div class="card product-card p-3">
                    <h4>${p.name}</h4>
                    <p><b>Price:</b> ₹${p.price}</p>
                    <p><b>Category:</b> ${p.category}</p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-warning btn-sm" onclick="editProduct(${p.id})">Edit</button>
                        <button class="btn btn-danger btn-sm" onclick="deleteProduct(${p.id})">Delete</button>
                    </div>
                </div>
            </div>
        `).join('');
    }

    // 3. HANDLE FORM SUBMIT - CREATE or UPDATE
    document.getElementById('productForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('productId').value;
        const product = {
            name: document.getElementById('name').value,
            price: document.getElementById('price').value,
            category: document.getElementById('category').value
        };

        if (editMode) {
            // UPDATE - PUT request
            await fetch(`${API_URL}/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(product)
            });
            editMode = false;
            document.getElementById('submitBtn').innerText = 'Add';
            document.getElementById('formTitle').innerText = 'Add New Product';
        } else {
            // CREATE - POST request
            await fetch(API_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(product)
            });
        }

        document.getElementById('productForm').reset();
        document.getElementById('productId').value = '';
        fetchProducts(); // Refresh UI
    });

    // 4. EDIT product - fetch single and fill form
    async function editProduct(id) {
        const res = await fetch(`${API_URL}/${id}`);
        const result = await res.json();
        const p = result.data;
        
        document.getElementById('productId').value = p.id;
        document.getElementById('name').value = p.name;
        document.getElementById('price').value = p.price;
        document.getElementById('category').value = p.category;
        
        editMode = true;
        document.getElementById('submitBtn').innerText = 'Update';
        document.getElementById('formTitle').innerText = 'Edit Product';
    }

    // 5. DELETE product
    async function deleteProduct(id) {
        if (confirm('Are you sure to delete this product?')) {
            await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
            fetchProducts(); // Refresh UI
        }
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>